# Meta Model API key used by the server-side Muse Spark adapter.
# Create a key in the Meta Model API dashboard and keep the real value in .env.
MODEL_API_KEY=
KAVIYO_MCP_PORT=8090

# Baseten-hosted Meta Muse Spark Open model used for controlled before/after shopper tests.
# Use the hackathon model ID meta-models/muse-spark-open-1026; never commit the real key.
BASETEN_API_KEY=

# Local synthetic PostgreSQL database only. Change these for any shared environment.
POSTGRES_DB=kaviyo
POSTGRES_USER=kaviyo
POSTGRES_PASSWORD=kaviyo_local_only
KAVIYO_DB_URL=jdbc:postgresql://127.0.0.1:5432/kaviyo
KAVIYO_DB_USER=kaviyo
KAVIYO_DB_PASSWORD=kaviyo_local_only

# Hosted production only. Use an OIDC provider that issues bearer access tokens and
# configure its API audience to KAVIYO_OIDC_CLIENT_ID. The token subject is mapped to
# one or more workspaces in PostgreSQL; select one with X-Kaviyo-Workspace-ID.
KAVIYO_OIDC_AUTH_SERVER_URL=
KAVIYO_OIDC_CLIENT_ID=
KAVIYO_CORS_ORIGINS=https://your-merchant-app.example

# For a hosted PostgreSQL service, use its TLS-enabled JDBC URL and credentials.
# These values are required by the Quarkus prod profile; local defaults are not used there.
# KAVIYO_DB_URL=jdbc:postgresql://db.example:5432/kaviyo?sslmode=require
# KAVIYO_DB_USER=kaviyo_app
# KAVIYO_DB_PASSWORD=replace-with-managed-secret

# Enabled by scripts/run-backend.sh for loopback local use only. Do not expose the scanner publicly yet.
KAVIYO_CRAWLER_ENABLED=true

# Optional public search provider for merchant market comparisons
BRAVE_SEARCH_API_KEY=
